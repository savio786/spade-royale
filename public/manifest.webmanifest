{
  "id": "/",
  "lang": "en-US",
  "dir": "ltr",
  "name": "Spade Haven — Online Spades",
  "short_name": "Spade Haven",
  "description": "Play Spades online on a casino table: Solo and Partners, live tables with real players, private games with friends, chat, championship rings and weekly leaderboards. Free to play with virtual coins.",
  "start_url": "./#play",
  "scope": "./",
  "display": "fullscreen",
  "display_override": [
    "fullscreen",
    "standalone"
  ],
  "orientation": "landscape",
  "background_color": "#1a0410",
  "theme_color": "#1a0410",
  "categories": [
    "games",
    "entertainment"
  ],
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "icons/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    }
  ],
  "screenshots": [
    {
      "src": "screenshots/1-sign-in.jpg",
      "sizes": "1280x720",
      "type": "image/jpeg",
      "form_factor": "wide",
      "label": "Sign in or play as a guest"
    },
    {
      "src": "screenshots/2-lobby.jpg",
      "sizes": "1280x720",
      "type": "image/jpeg",
      "form_factor": "wide",
      "label": "The casino lobby"
    },
    {
      "src": "screenshots/4-play.jpg",
      "sizes": "1280x720",
      "type": "image/jpeg",
      "form_factor": "wide",
      "label": "Partners table with aurora felt"
    },
    {
      "src": "screenshots/6-profile.jpg",
      "sizes": "1280x720",
      "type": "image/jpeg",
      "form_factor": "wide",
      "label": "Player profile and rings"
    },
    {
      "src": "screenshots/7-results.jpg",
      "sizes": "1280x720",
      "type": "image/jpeg",
      "form_factor": "wide",
      "label": "Round results"
    }
  ],
  "launch_handler": {
    "client_mode": "focus-existing"
  }
