# Where the native apps (and any separately hosted web build) find the multiplayer server.
# Leave empty when the web app is served by the server itself (same origin).
VITE_SERVER_URL=wss://play.example.com/ws
# Store links shown on the landing page
VITE_PLAY_STORE_URL=https://play.google.com/store/apps/details?id=com.spaderoyale.app
VITE_APP_STORE_URL=https://apps.apple.com/app/idYOUR_APP_ID
